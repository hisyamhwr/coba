# API key dari https://console.anthropic.com (untuk membuat ringkasan)
ANTHROPIC_API_KEY=

# Ukuran model Whisper: tiny, base, small, medium, large-v3
WHISPER_MODEL=small

# Bahasa utama rapat: id, en, atau auto
MEETING_LANGUAGE=id

# Folder penyimpanan notulen
OUTPUT_DIR=~/MeetingNotes

# Rekam juga suara peserta meeting online dari speaker/headphone (Windows & Linux)
CAPTURE_SYSTEM_AUDIO=true
