# Cara membuat ringkasan:
#   auto        = Claude API jika ANTHROPIC_API_KEY diisi, selain itu Claude Code (langganan Pro/Max)
#   claude-code = selalu pakai Claude Code, memakai kuota langganan Claude Pro/Max, tanpa biaya API
#   api         = selalu pakai Claude API (berbayar per pemakaian)
#   none        = hanya transkrip
SUMMARIZER=auto

# Model untuk mode claude-code. Kosong = sonnet (MoM rapat 1 jam +-25 detik); opus lebih lambat.
CLAUDE_CODE_MODEL=
# Effort untuk mode claude-code: low, medium, high. Kosong = medium.
CLAUDE_CODE_EFFORT=

# Hanya untuk mode api: key dari https://console.anthropic.com (berbayar)
ANTHROPIC_API_KEY=

# Model Whisper: auto (large-v3 di Mac Apple Silicon RAM >= 16 GB, selain itu large-v3-turbo),
# atau paksa: tiny, base, small, medium, large-v3, large-v3-turbo
WHISPER_MODEL=auto

# Mesin Whisper: auto (mlx di Mac M1/M2/..., selain itu faster-whisper), mlx, faster-whisper
WHISPER_ENGINE=auto

# Bahasa utama rapat: id, en, atau auto
MEETING_LANGUAGE=id

# Buat juga file Word (.docx) selain Markdown (.md): true/false
EXPORT_DOCX=false

# Folder penyimpanan notulen
OUTPUT_DIR=~/MeetingNotes

# Rekam juga suara peserta meeting online dari speaker/headphone (Windows & Linux)
CAPTURE_SYSTEM_AUDIO=true

# Mesin transkripsi cloud (opsional). Isi yang ingin diuji dengan `python -m meeting_notes bandingkan`.
ELEVENLABS_API_KEY=
ASSEMBLYAI_API_KEY=
DEEPGRAM_API_KEY=
